#!/bin/bash
# Post-install script for Forge OS PKG installer.
# 1. Clears the com.apple.quarantine attribute so macOS allows the unsigned app to run.
# 2. Launches the app so users don't need to find and open it manually.

APP="/Applications/Forge OS.app"

echo "Clearing quarantine attribute..."
xattr -cr "$APP" || true

echo "Launching Forge OS..."
# open -n avoids reusing an existing instance; backgrounded so the installer
# completes immediately rather than waiting for the app process to exit.
open -n -a "$APP" &

exit 0
