{
  "name": "forge-os",
  "version": "1.0.0-beta.119",
  "description": "Forge OS — Documentation-first PDLC automation desktop app",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build:mac": "electron-builder --mac",
    "build:win": "electron-builder --win",
    "build:linux": "electron-builder --linux",
    "build:all": "electron-builder --mac --win --linux"
  },
  "dependencies": {
    "electron-updater": "^6.3.0"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.0",
    "@electron/notarize": "^2.5.0"
  },
  "build": {
    "afterSign": "scripts/notarize.js",
    "appId": "com.forgeos.desktop",
    "productName": "Forge OS",
    "buildVersion": "1.0.0.24",
    "artifactName": "forge-os-${version}-${arch}-${os}.${ext}",
    "copyright": "Copyright © 2026",
    "extraResources": [
      {
        "from": "../forge",
        "to": "forge",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../src/dashboard.html",
        "to": "dashboard.html"
      }
    ],
    "files": [
      "main.js",
      "preload.js",
      "auth.js",
      "github.js",
      "org.js",
      "auth-preload.js",
      "setup-preload.js",
      "auth-window.html",
      "setup-window.html",
      "assets/**/*"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "assets/icon.icns",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "assets/entitlements.mac.plist",
      "entitlementsInherit": "assets/entitlements.mac.plist",
      "extendInfo": {
        "NSApplicationDataUsageDescription": "Forge OS runs AI CLI tools (Gemini, Claude, Codex) as subprocesses. These tools read their own stored credentials to authenticate with AI APIs.",
        "NSDesktopFolderUsageDescription": "Forge OS does not access your Desktop. If prompted, deny — this request should not occur.",
        "NSDocumentsFolderUsageDescription": "Forge OS accesses project files you have opened or created within the app."
      },
      "target": [
        "dmg",
        "pkg",
        "zip"
      ]
    },
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "linux": {
      "icon": "assets/icon.png",
      "category": "Development",
      "target": [
        "AppImage"
      ]
    },
    "dmg": {
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "pkg": {
      "scripts": "scripts/pkg",
      "installLocation": "/Applications",
      "allowAnywhere": true,
      "allowCurrentUserHome": true,
      "allowRootDirectory": true
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "runAfterFinish": true
    },
    "publish": {
      "provider": "github",
      "owner": "saturday-connect",
      "repo": "forge-os"
    }
  }
}
